# ==============================================================================
# Claude Code 定时刷新配置 (示例模版)
# ==============================================================================

# 定时触发时间点，使用本机当前时区。
# macOS launchd 会在这些时间点执行一次 `claude -p`，用于开启/刷新 Claude 的 5 小时窗口。
# 多个时间点用英文逗号分隔，格式为 HH:MM。
SCHEDULE_TIMES="08:30,14:00,19:10"

# 随机延迟上限，单位为秒。
# 设为 300 表示每次到点后随机等待 0-300 秒再执行，避免精确卡点。
# 如果你希望严格按时间点执行，改为 0。
MAX_RANDOM_DELAY_SECS=300

# 自动发送给 Claude Code 的最小提示。
# 建议保持简短，避免浪费额度；脚本不会把这个内容写入日志。
REFRESH_MESSAGE="Hi"

# Claude 运行的目标工作目录。
# 支持使用 $HOME 或 ~ 指向当前用户家目录。
# 不建议设为 Desktop/Documents 等 TCC 保护目录；保持默认即可。
TARGET_WORKSPACE="$HOME/.claude-autorefresh"

# 是否在每次发送消息或完成刷新时向 macOS 通知中心发送推送通知。
# 设为 true 启用通知，设为 false 禁用。
ENABLE_NOTIFICATIONS=true
